# Copy to .env (git-ignored) or export in your shell / deployment. Loaded via spring.config.import.
DB_R2DBC_URL=r2dbc:postgresql://localhost:5432/lailo
DB_JDBC_URL=jdbc:postgresql://localhost:5432/lailo
DB_USERNAME=lailo
DB_PASSWORD=
MONGODB_URI=mongodb://localhost:27017/lailo
REDIS_HOST=localhost
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# >= 32 random chars each, e.g. `openssl rand -base64 48`
LAILO_JWT_SECRET=
LAILO_OTP_HASH_SECRET=
# builtin | turnstile
LAILO_CAPTCHA_PROVIDER=builtin
LAILO_TURNSTILE_SITE_KEY=
LAILO_TURNSTILE_SECRET=
LAILO_WEB_ORIGINS=http://localhost:3000
# S3-compatible media store (SeaweedFS). Values below match compose.yaml + infra/seaweedfs/s3.json.
LAILO_STORAGE_ENDPOINT=http://localhost:8333
LAILO_STORAGE_BUCKET=lailo-media
LAILO_STORAGE_ACCESS_KEY=lailo-dev
LAILO_STORAGE_SECRET_KEY=lailo-dev-secret
# Public (or CDN) base URL browsers fetch product media from
LAILO_STORAGE_PUBLIC_BASE_URL=http://localhost:8333/lailo-media
