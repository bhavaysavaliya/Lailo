<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Lailo documentation rule: every type, constructor and method - at every access level, in main AND test code -
  must have a Javadoc comment. Test methods describe the condition under test (Given / When / Then).
  Fields are exempt. Runs in `validate`, so `./mvnw test` and `./mvnw verify` fail on a missing comment.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <module name="TreeWalker">
        <module name="MissingJavadocType">
            <property name="scope" value="private"/>
        </module>
        <module name="MissingJavadocMethod">
            <property name="scope" value="private"/>
            <property name="allowMissingPropertyJavadoc" value="false"/>
            <!-- no exemption for @Override: implementations document what they do differently -->
            <property name="allowedAnnotations" value="NoExemptAnnotation"/>
            <property name="minLineCount" value="-1"/>
            <property name="tokens" value="METHOD_DEF, CTOR_DEF, ANNOTATION_FIELD_DEF, COMPACT_CTOR_DEF"/>
        </module>
        <module name="InvalidJavadocPosition"/>
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public, protected, package, private"/>
            <property name="validateThrows" value="false"/>
            <property name="allowMissingParamTags" value="true"/>
            <property name="allowMissingReturnTag" value="true"/>
        </module>
    </module>
</module>
